{
  "name": "@h5web/app",
  "version": "19.0.0-beta.0",
  "description": "H5Web app and providers",
  "author": "European Synchrotron Radiation Facility",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/silx-kit/h5web"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "exports": {
      "./styles.css": "./dist/styles.css",
      ".": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "vite build && pnpm \"/^build:/\"",
    "build:css": "vite build --config vite.styles.config.js && concat dist-css/lib.css dist/app.css -o dist/styles.css && rimraf dist/app.css",
    "build:dts": "tsc --build tsconfig.build.json && rollup -c",
    "lint:eslint": "eslint --max-warnings=0",
    "lint:tsc": "tsc",
    "sync-version": "dot-json ../../package.json version | xargs dot-json package.json version"
  },
  "peerDependencies": {
    "@types/react": "19.x",
    "@types/react-dom": "19.x",
    "axios": ">=1",
    "react": "19.x",
    "react-dom": "19.x",
    "typescript": ">=4.5"
  },
  "peerDependenciesMeta": {
    "@types/react": {
      "optional": true
    },
    "@types/react-dom": {
      "optional": true
    },
    "axios": {
      "optional": true
    },
    "typescript": {
      "optional": true
    }
  },
  "dependencies": {
    "@h5web/lib": "workspace:*",
    "@react-hookz/web": "26.1.0",
    "@react-three/fiber": "9.8.2",
    "@tanstack/react-query": "5.105.0",
    "@types/d3-format": "~3.0.4",
    "@types/ndarray": "1.1.0",
    "d3-format": "3.1.2",
    "ndarray": "1.1.1",
    "ndarray-ops": "1.2.2",
    "react-error-boundary": "6.1.6",
    "react-icons": "5.7.0",
    "react-resizable-panels": "4.20.0",
    "three": "0.186.1",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@esrf/eslint-config": "4.0.4",
    "@h5web/shared": "workspace:*",
    "@rollup/plugin-alias": "6.0.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "@vitest/browser-playwright": "5.1.0",
    "axios": "1.21.0",
    "concat": "1.0.3",
    "dot-json": "1.3.0",
    "eslint": "10.13.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "rimraf": "6.1.3",
    "rollup": "4.65.1",
    "rollup-plugin-dts": "6.5.1",
    "typescript": "6.0.3",
    "vite": "8.3.6",
    "vite-css-modules": "1.16.1",
    "vite-plugin-react-fallback-throttle": "0.1.3",
    "vitest": "5.1.0",
    "vitest-browser-react": "2.3.0",
    "vitest-fail-on-console": "0.10.1"
  }
}
