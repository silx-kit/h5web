{
  "name": "@h5web/h5wasm",
  "version": "17.0.0",
  "description": "H5Web providers based on H5Wasm",
  "author": "European Synchrotron Radiation Facility",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/silx-kit/h5web"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "exports": {
      ".": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "vite build && pnpm build:dts",
    "build:dts": "tsc --build tsconfig.build.json && rollup -c",
    "lint:eslint": "eslint --max-warnings=0",
    "lint:tsc": "tsc",
    "sync-version": "dot-json ../../package.json version | xargs dot-json package.json version"
  },
  "peerDependencies": {
    "@h5web/app": "workspace:*",
    "@types/react": "18.x",
    "h5wasm-plugins": "0.3.0",
    "react": "18.x",
    "typescript": ">=4.5"
  },
  "peerDependenciesMeta": {
    "@types/react": {
      "optional": true
    },
    "h5wasm-plugins": {
      "optional": true
    },
    "typescript": {
      "optional": true
    }
  },
  "dependencies": {
    "comlink": "4.4.2",
    "h5wasm": "0.10.3",
    "nanoid": "5.1.16"
  },
  "devDependencies": {
    "@esrf/eslint-config": "3.1.0",
    "@h5web/app": "workspace:*",
    "@h5web/shared": "workspace:*",
    "@rollup/plugin-alias": "6.0.0",
    "@types/node": "^24.13.2",
    "@types/react": "^18.3.31",
    "@vitejs/plugin-react": "6.0.3",
    "dot-json": "1.3.0",
    "eslint": "9.39.4",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "rollup": "4.62.2",
    "rollup-plugin-dts": "6.4.1",
    "typescript": "6.0.3",
    "vite": "8.1.2",
    "vitest": "4.1.9"
  }
}
