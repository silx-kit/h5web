{
  "name": "storybook",
  "private": true,
  "version": "0.0.1",
  "description": "Storybook for @h5web/lib",
  "type": "module",
  "scripts": {
    "start": "storybook dev -p 6006",
    "build": "storybook build -o build",
    "serve": "pnpm dlx http-server -p 6006 ./build",
    "lint:eslint": "eslint --max-warnings=0",
    "lint:tsc": "tsc"
  },
  "dependencies": {
    "@h5web/lib": "workspace:*",
    "@h5web/shared": "workspace:*",
    "@react-hookz/web": "26.1.0",
    "@react-three/fiber": "9.8.1",
    "d3-array": "3.2.4",
    "d3-format": "3.1.2",
    "greenlet": "1.1.0",
    "modern-normalize": "3.0.1",
    "ndarray": "1.0.19",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-icons": "5.7.0",
    "three": "0.185.1"
  },
  "devDependencies": {
    "@esrf/eslint-config": "3.1.0",
    "@storybook/addon-docs": "10.4.6",
    "@storybook/addon-links": "10.4.6",
    "@storybook/react-vite": "10.4.6",
    "@types/d3-array": "~3.2.2",
    "@types/d3-format": "~3.0.4",
    "@types/ndarray": "1.0.14",
    "@types/node": "^24.13.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "0.185.3",
    "eslint": "9.39.4",
    "remark-gfm": "4.0.1",
    "storybook": "10.4.6",
    "typescript": "6.0.3",
    "vite": "8.1.2"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version"
    ]
  }
}
